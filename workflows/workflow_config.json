{
  "workflows": {
    "flux_lora": {
      "file": "flux_lora_workflow.json",
      "name": "Flux + LoRA Generation",
      "description": "Local Flux.1-dev with custom LoRA support",
      "uses_api_nodes": false,
      "estimated_cost_per_image": 0.00,
      "parameters": {
        "prompt": {
          "type": "string",
          "required": true,
          "description": "Text prompt for image generation"
        },
        "negative_prompt": {
          "type": "string",
          "default": "blurry, bad quality, distorted",
          "description": "Negative prompt to avoid unwanted elements"
        },
        "lora_path": {
          "type": "string",
          "default": "default.safetensors",
          "description": "Path to LoRA file for style customization"
        },
        "lora_strength": {
          "type": "float",
          "min": 0.0,
          "max": 2.0,
          "default": 0.8,
          "description": "Strength of LoRA application"
        },
        "resolution": {
          "type": "string",
          "options": ["512x512", "768x768", "1024x1024", "1024x1536", "1536x1024"],
          "default": "1024x1024",
          "description": "Output image resolution"
        },
        "steps": {
          "type": "integer",
          "min": 1,
          "max": 50,
          "default": 20,
          "description": "Number of inference steps"
        },
        "guidance_scale": {
          "type": "float",
          "min": 1.0,
          "max": 20.0,
          "default": 7.5,
          "description": "Guidance scale for prompt adherence"
        },
        "seed": {
          "type": "integer",
          "default": -1,
          "description": "Random seed (-1 for random)"
        },
        "batch_size": {
          "type": "integer",
          "min": 1,
          "max": 4,
          "default": 1,
          "description": "Number of images to generate"
        }
      },
      "parameter_mappings": {
        "prompt": {
          "node": "6",
          "input_key": "text"
        },
        "negative_prompt": {
          "node": "7", 
          "input_key": "text"
        },
        "lora_strength": {
          "node": "10",
          "input_key": "strength_model",
          "secondary_mappings": [
            {
              "node": "10",
              "input_key": "strength_clip"
            }
          ]
        },
        "resolution": {
          "special_handler": "resolution",
          "width_mapping": {
            "node": "5",
            "input_key": "width"
          },
          "height_mapping": {
            "node": "5", 
            "input_key": "height"
          },
          "upscale_width_mapping": {
            "node": "12",
            "input_key": "width",
            "multiplier": 4
          },
          "upscale_height_mapping": {
            "node": "12",
            "input_key": "height", 
            "multiplier": 4
          }
        },
        "steps": {
          "node": "3",
          "input_key": "steps"
        },
        "guidance_scale": {
          "node": "3",
          "input_key": "cfg"
        },
        "seed": {
          "special_handler": "random_seed",
          "node": "3",
          "input_key": "seed"
        },
        "batch_size": {
          "node": "5",
          "input_key": "batch_size"
        },
        "output_prefix": {
          "special_handler": "style_output",
          "node": "9",
          "input_key": "filename_prefix"
        }
      },
      "node_mappings": {
        "lora_loader": "10",
        "sampler": "3",
        "latent_image": "5",
        "save_image": "9"
      }
    },
